<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTieuDeChiTiet_120"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHI TIẾT KHOẢN CHI"
            android:textAlignment="center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvTenKhoanChi_120"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên khoản chi:"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSoTien_120"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Số tiền:"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvGhiChu_120"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghi chú:"
            android:textSize="18sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnQuayLai_120"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quay lại" />

    </LinearLayout>

</ScrollView>