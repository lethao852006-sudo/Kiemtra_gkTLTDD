<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTieuDe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUẢN LÝ KHOẢN CHI"
            android:textAlignment="center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvThongTinSinhVien"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sinh viên: LeThiMinhThao\nMSSV: 2414151122120"
            android:textSize="16sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvNhanTenKhoanChi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên khoản chi" />

        <EditText
            android:id="@+id/edtTenKhoanChi_120"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập tên khoản chi"
            android:inputType="text"
            android:layout_marginBottom="16dp" />
        <EditText
            android:id="@+id/edtLoaiChi_120"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập loại chi (VD: Ăn uống, Đi lại...)"
            android:inputType="text"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvNhanSoTien"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Số tiền" />

        <EditText
            android:id="@+id/edtSoTien_120"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập số tiền"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvNhanGhiChu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghi chú" />

        <EditText
            android:id="@+id/edtGhiChu_120"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập ghi chú"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnThemKhoanChi_120"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thêm khoản chi"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnXemChiTiet_120"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xem chi tiết khoản chi" />

    </LinearLayout>

</ScrollView>